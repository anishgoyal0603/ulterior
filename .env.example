# Copy to .env and fill in real values. NEVER commit .env (it's gitignored).
#   cp .env.example .env
#
# For LOCAL DEVELOPMENT you can leave this entire file unset — every value
# has a safe local default and the app starts with zero configuration.
# In PRODUCTION (APP_ENV=production) the app REFUSES TO START if any of the
# critical values below are missing or unsafe. See app/config.py.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# "development" (default) or "production". Anything not exactly "production"
# is treated as development, so a typo fails SAFE rather than silently
# disabling protections.
APP_ENV=production

# Debug defaults to OFF and is FORCE-DISABLED in production regardless of
# this value. Never set this true on a deployed instance.
DEBUG=false

# ---------------------------------------------------------------------------
# Database  (REQUIRED in production)
# ---------------------------------------------------------------------------
# Production must use PostgreSQL with TLS. The app refuses to start if:
#   - DATABASE_URL is unset (would silently fall back to local SQLite)
#   - DATABASE_URL points at SQLite
#   - the Postgres URL has no sslmode parameter (unencrypted in transit)
POSTGRES_DB=darkpattern_auditor
POSTGRES_USER=replace_with_db_user
POSTGRES_PASSWORD=replace_with_a_strong_random_password
DATABASE_URL=postgresql://replace_with_db_user:replace_with_a_strong_random_password@postgres:5432/darkpattern_auditor?sslmode=require

# ---------------------------------------------------------------------------
# Redis  (production Celery path)
# ---------------------------------------------------------------------------
# Redis has NO authentication by default — always set a password. The compose
# file does not publish port 6379 to the host for the same reason.
REDIS_PASSWORD=replace_with_a_strong_random_password
REDIS_URL=redis://:replace_with_a_strong_random_password@redis:6379/0

# ---------------------------------------------------------------------------
# CORS  (REQUIRED in production)
# ---------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins. The app refuses to start
# in production if this contains "*" or any plain-HTTP origin.
CORS_ALLOW_ORIGINS=https://your-frontend-domain.example.com

# ---------------------------------------------------------------------------
# Reverse proxy
# ---------------------------------------------------------------------------
# Set true ONLY when running behind a trusted reverse proxy (nginx, Caddy,
# a cloud load balancer). It makes the app trust X-Forwarded-For for client
# IP resolution. If the app is directly internet-facing, leave this false —
# otherwise a client can spoof the header and bypass rate limiting.
TRUST_PROXY_HEADERS=true

# ---------------------------------------------------------------------------
# Rate limiting (requests per window, per client IP)
# ---------------------------------------------------------------------------
RATE_LIMIT_AUDIT_PER_MINUTE=5
RATE_LIMIT_DELETE_PER_HOUR=3
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Layer 3 language detection (OPTIONAL)
# ---------------------------------------------------------------------------
# If unset, Layer 3 runs a local heuristic stub and NOTHING leaves the
# machine. SERVER-SIDE ONLY — never expose this to client-side code.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Authentication  (REQUIRED in production)
# ---------------------------------------------------------------------------
# Without this, ANY caller can read and delete every audit. Production
# refuses to start if API_KEYS is empty or any key is under 24 chars.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=replace_with_generated_key_1,replace_with_generated_key_2
# Subset of API_KEYS allowed to use DELETE routes. Keep the dashboard's key
# OUT of this list so a leaked read key cannot wipe the database.
ADMIN_API_KEYS=replace_with_generated_key_2

# ---------------------------------------------------------------------------
# Retention  (bounds disk/DB growth and limits how long captured page
# content is stored — see the Privacy section of the README)
# ---------------------------------------------------------------------------
RETENTION_DAYS=30
MAX_STORED_AUDITS=500
