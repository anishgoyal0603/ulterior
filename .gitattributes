# Line endings.
#
# run_demo.sh MUST keep LF endings. If git or an unzip tool hands a Windows
# checkout a CRLF copy and it is later run under WSL or Git Bash, bash fails
# with the famously unhelpful:
#     $'\r': command not found
# Marking shell scripts as LF prevents that regardless of the user's
# core.autocrlf setting.
*.sh text eol=lf

# PowerShell is happy either way, but CRLF is the native convention.
*.ps1 text eol=crlf

# Everything else: normalise in the repo, let git decide on checkout.
* text=auto

# Never touch binaries.
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
