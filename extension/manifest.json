{
  "manifest_version": 3,
  "name": "Ulterior by The Odyssey",
  "short_name": "Ulterior",
  "version": "2.2.0",
  "description": "Spots hidden fees, fake timers and other dark patterns while you shop, tracks prices and alerts you when they drop.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.in/*",
        "https://*.flipkart.com/*",
        "https://*.myntra.com/*",
        "https://*.ajio.com/*",
        "https://*.meesho.com/*",
        "https://*.nykaa.com/*",
        "https://*.nykaafashion.com/*",
        "https://*.tatacliq.com/*",
        "https://*.jiomart.com/*",
        "https://*.snapdeal.com/*",
        "https://*.firstcry.com/*",
        "https://*.croma.com/*",
        "https://*.reliancedigital.in/*",
        "https://*.lenskart.com/*",
        "https://*.bigbasket.com/*",
        "https://*.swiggy.com/*",
        "https://*.zomato.com/*",
        "https://*.blinkit.com/*",
        "https://*.zeptonow.com/*",
        "https://*.bookmyshow.com/*",
        "https://*.district.in/*",
        "https://*.makemytrip.com/*",
        "https://*.goibibo.com/*",
        "https://*.cleartrip.com/*",
        "https://*.yatra.com/*",
        "https://*.ixigo.com/*",
        "https://*.easemytrip.com/*",
        "https://*.redbus.in/*",
        "https://*.trivago.in/*",
        "https://*.booking.com/*",
        "https://*.agoda.com/*",
        "https://*.goindigo.in/*",
        "https://*.airindia.com/*",
        "https://*.spicejet.com/*",
        "https://*.akasaair.com/*",
        "https://*.oyorooms.com/*",
        "https://ulterior-api-production.up.railway.app/storefront/*",
        "https://ulterior-api-production.up.railway.app/storefront-clean/*"
      ],
      "js": [
        "src/core.js",
        "src/platform.js",
        "src/detect.js",
        "src/chart.js",
        "src/journey.js",
        "src/history.js",
        "src/watch.js",
        "src/overlay.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Ulterior: check this page",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://ulterior-api-production.up.railway.app/",
  "optional_host_permissions": [
    "https://ulterior-api-production.up.railway.app/*"
  ]
}
